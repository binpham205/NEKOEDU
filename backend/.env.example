# Copy file này thành .env rồi sửa giá trị: cp .env.example .env

# development | testing | production
APP_ENV=development
SECRET_KEY=change-me
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=DEBUG

# PostgreSQL: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/neko_edu
# Database riêng cho pytest, tên BẮT BUỘC kết thúc bằng _test (test sẽ xóa sạch dữ liệu DB này)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/neko_edu_test

# JWT: tối thiểu 32 ký tự. Tạo ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480

# Các origin của frontend được phép gọi API, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
