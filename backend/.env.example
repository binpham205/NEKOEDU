# Copy file này thành .env rồi sửa giá trị: cp .env.example .env

# development | testing | production
APP_ENV=development
SECRET_KEY=change-me
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=DEBUG

# Các origin của frontend được phép gọi API, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Dùng khi thêm PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/neko_edu
